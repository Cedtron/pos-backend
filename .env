# ─── Local Development Configuration ─────────────────────────────────────────
# These values are used when DB_URL is NOT set (local MySQL).
# Make sure you have MySQL running locally and a database named "baala" created.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=baala

# ─── Production Database URL ──────────────────────────────────────────────────
# Uncomment and fill in the line below ONLY when deploying to production.
DB_URL=mysql://UTgbpvDU9jUnSiD.root:jI6Rx3aconzWYN33@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/test

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_production
